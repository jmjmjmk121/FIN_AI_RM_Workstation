# Copy to .env and replace placeholders locally. Never commit real values.

# fixture = run from bundled EOD fixtures, no credentials needed.
# live    = call the official SETSMART Listed-company EOD API.
SETSMART_LISTED_DATA_MODE=fixture
SETSMART_API_KEY=replace_with_newly_rotated_key

SETSMART_BASE_URL=https://www.setsmart.com/api/listed-company-api
SETSMART_TIMEOUT_MS=8000
SETSMART_CACHE_TTL_MS=900000
SETSMART_MAX_RETRIES=2
SETSMART_RETRY_BASE_MS=250
SETSMART_STALE_AFTER_DAYS=10

# Business date the modules evaluate against. Blank = today (Asia/Bangkok).
RM_AS_OF_DATE=
RM_ID=RM001
